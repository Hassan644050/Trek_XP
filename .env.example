# Copy this file to `.env` and fill in your own key.
#   cp .env.example .env

# --- LLM provider ---
# Which hosted LLM to use: "gemini" or "nvidia".
LLM_PROVIDER=gemini

# Gemini  -> free key at https://aistudio.google.com/apikey  (e.g. gemini-3.6-flash)
# NVIDIA  -> free key at https://build.nvidia.com/
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-3.6-flash

# Destination search surfaces this country first (ISO 3166-1 alpha-2).
HOME_COUNTRY=BD

# How long to wait on the model before giving up, in seconds. A real call
# has been measured at 52s, so do not set these tight.
#   LLM_TIMEOUT_SECONDS        one HTTP attempt
#   LLM_TOTAL_TIMEOUT_SECONDS  the whole call, retries included
# LLM_TIMEOUT_SECONDS=75
# LLM_TOTAL_TIMEOUT_SECONDS=100

# --- Database (coordinator area) ---
# Neon: Dashboard -> Connect -> copy the connection string as-is.
DATABASE_URL=postgresql://user:password@ep-example-123-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# A SEPARATE database for the automated tests (e.g. a Neon branch named "test").
# The tests empty its tables; they refuse to run if this equals DATABASE_URL.
# TEST_DATABASE_URL=postgresql://...

# --- Sign-in ---
# Set to true in production (HTTPS). Leave false for local http://.
COOKIE_SECURE=false
SESSION_HOURS=12

# --- Images ---
# Local disk is for development only: free hosting tiers wipe their disk on
# every deploy, so uploaded images would vanish. Set the R2 block below in
# production.
# Local folder for uploaded gadget images (default: ./media).
# MEDIA_DIR=/var/lib/trekxp/media

# Cloudflare R2. Leave all five blank to use local disk; setting only some of
# them is refused at startup, because images would be stored where the app
# cannot serve them.
#
# In the Cloudflare dashboard:
#   1. R2 -> Create bucket (any name, Automatic location).
#   2. R2 -> API -> Manage API tokens -> Create token, "Object Read & Write",
#      scoped to that one bucket. Copy the Access Key ID and Secret -- the
#      secret is shown once.
#   3. The bucket -> Settings -> Public access. Either enable the r2.dev
#      subdomain (fine to start with; rate-limited, not for real traffic) or
#      attach a custom domain. Uploading does NOT make a bucket readable.
#   4. Put the resulting hostname in R2_PUBLIC_BASE_URL, no trailing path.
#
# R2_ACCOUNT_ID is the hex id in the dashboard URL, not your email.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
