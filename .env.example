# Copy this file to `.env` and fill in your own key.
#   cp .env.example .env

# --- LLM provider ---
# Which hosted LLM to use: "gemini" or "nvidia".
LLM_PROVIDER=gemini

# Gemini  -> free key at https://aistudio.google.com/apikey  (e.g. gemini-3.6-flash)
# NVIDIA  -> free key at https://build.nvidia.com/
LLM_API_KEY=your-llm-api-key
LLM_MODEL=gemini-3.6-flash

# Destination search surfaces this country first (ISO 3166-1 alpha-2).
HOME_COUNTRY=BD

# --- Database (coordinator area) ---
# Neon: Dashboard -> Connect -> copy the connection string as-is.
DATABASE_URL=postgresql://user:password@ep-example-123-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# A SEPARATE database for the automated tests (e.g. a Neon branch named "test").
# The tests empty its tables; they refuse to run if this equals DATABASE_URL.
# TEST_DATABASE_URL=postgresql://...

# --- Sign-in ---
# Set to true in production (HTTPS). Leave false for local http://.
COOKIE_SECURE=false
SESSION_HOURS=12

# --- Images ---
# Local folder for uploaded gadget images (default: ./media).
# MEDIA_DIR=/var/lib/trekxp/media
